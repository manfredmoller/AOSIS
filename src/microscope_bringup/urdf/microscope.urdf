<?xml version="1.0"?>
<robot name="digital_microscope">

  <link name="world"/>

  <link name="realsense_link">
    <visual>
      <geometry>
        <box size="0.09 0.025 0.025"/> </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_realsense" type="fixed">
    <parent link="world"/>
    <child link="realsense_link"/>
    <origin xyz="0 0 0.5" rpy="0 1.5708 0"/> 
  </joint>

  <link name="gantry_head_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>

  <joint name="world_to_gantry" type="fixed">
    <parent link="world"/>
    <child link="gantry_head_link"/>
    <origin xyz="0.1 0.1 0.1" rpy="0 0 0"/>
  </joint>

  <link name="uc70_optical_frame"/>

  <joint name="gantry_to_uc70" type="fixed">
    <parent link="gantry_head_link"/>
    <child link="uc70_optical_frame"/>
    <origin xyz="0 0 -0.05" rpy="0 1.5708 0"/>
  </joint>

</robot>
